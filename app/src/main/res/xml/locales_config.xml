<?xml version="1.0" encoding="utf-8"?>
<!--
  locales_config.xml — Android 13+ per-app language preferences.

  Declares the languages the OS Settings -> App languages UI may offer for this
  app. Consumed ONLY by the Android OS (manifest android:localeConfig); no app
  code reads this file, and the app's own language switching is driven by the
  stored preference via AppLocales + attachBaseContext/RuntimeLocaleProvider.

  Shaheen 2 (language elimination batch, 2026-11-03): English only.
  ja/ko/ru/es/pt-rBR were removed in an earlier step; zh is removed now that
  the preference defaults to "en", AppLocales no longer parses "zh", and the
  default values/ tree physically holds English text.
  Do NOT add "ur" here until values-ur/ actually ships at full key parity —
  otherwise the OS could set an "ur" configuration that falls back per-string
  to the default resources.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
</locale-config>
